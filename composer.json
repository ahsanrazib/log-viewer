{
    "name": "solvercircle/log-viewer",
    "description": "A modern, interactive log viewer for Laravel applications",
    "type": "library",
    "keywords": [
        "laravel",
        "log",
        "logs",
        "log-viewer",
        "logging",
        "ui",
        "monolog"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ahsan Razib",
            "email": "ahsan@solvercircle.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ahsanrazib\\LogViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahsanrazib\\LogViewer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahsanrazib\\LogViewer\\LogViewerServiceProvider"
            ],
            "aliases": {
                "LogViewer": "Ahsanrazib\\LogViewer\\Facades\\LogViewer"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
